{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: 1. Eureka Server",
      "type": "shell",
      "command": "export JAVA_HOME=/Library/Java/JavaVirtualMachines/jdk-17.jdk/Contents/Home && mvn spring-boot:run",
      "options": {
        "cwd": "${workspaceFolder}/backend/eureka-server",
        "shell": {
          "executable": "/bin/zsh",
          "args": ["-l", "-c"]
        }
      },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Backend: 2. API Gateway",
      "type": "shell",
      "command": "export JAVA_HOME=/Library/Java/JavaVirtualMachines/jdk-17.jdk/Contents/Home && mvn spring-boot:run",
      "options": {
        "cwd": "${workspaceFolder}/backend/api-gateway",
        "shell": {
          "executable": "/bin/zsh",
          "args": ["-l", "-c"]
        }
      },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Backend: 3. Auth Service",
